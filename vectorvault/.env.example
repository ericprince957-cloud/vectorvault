# Supabase — get these from your Supabase project dashboard (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Never commit real keys. Copy this file to .env.local and fill in your values.
# The service_role key must NEVER be exposed to the client or committed.
