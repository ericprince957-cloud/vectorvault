# Supabase — use the publishable key from Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Legacy compatibility only. Use the publishable key above for new setups.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key

# Never commit real keys. Copy this file to .env.local and fill in your values.
# Never expose a Supabase secret/service_role key in browser code.
